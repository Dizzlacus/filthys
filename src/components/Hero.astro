---
import { Picture } from 'astro:assets';
import { site, heroHighlights, heroVideo, withBase } from '../data/site';
import heroPoster from '../assets/images/hero-poster.jpg';

const hasVideo = Boolean(heroVideo.mp4 || heroVideo.webm);
---

<section
  id="hero"
  class="relative isolate flex min-h-[100svh] items-center justify-center overflow-hidden bg-page md:min-h-[100vh]"
>
  <div class="absolute inset-0 -z-30 overflow-hidden" aria-hidden="true">
    <Picture
      src={heroPoster}
      formats={['avif', 'webp']}
      alt=""
      width={1280}
      height={720}
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  {
    hasVideo && (
      <video
        id="hero-video"
        class="absolute inset-0 -z-20 h-full w-full object-cover opacity-0 transition-opacity duration-700"
        src={!heroVideo.webm && heroVideo.mp4 ? withBase(heroVideo.mp4) : undefined}
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        disablepictureinpicture
        aria-hidden="true"
        tabindex="-1"
      >
        {heroVideo.webm && <source src={withBase(heroVideo.webm)} type="video/webm" />}
        {heroVideo.webm && heroVideo.mp4 && (
          <source src={withBase(heroVideo.mp4)} type="video/mp4" />
        )}
      </video>
    )
  }

  <!-- Scrims: top for nav, global tint, radial behind the logo, bottom into the next section -->
  <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-page/35"></div>
    <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-page/70 to-transparent"></div>
    <div class="hero-scrim-radial absolute inset-0"></div>
    <div class="absolute inset-x-0 bottom-0 h-[40%] bg-gradient-to-t from-page via-page/60 to-transparent"></div>
  </div>

  <div class="relative z-10 flex w-full flex-col items-center px-5 pb-32 pt-28 text-center md:pb-36 md:pt-32">
    <h1 class="reveal flex justify-center">
      <span class="sr-only">{site.heroSeoHeadline}</span>
      <img
        src={withBase('/img/filthys-logo.svg')}
        alt=""
        width="500"
        height="213"
        class="hero-logo w-[min(80vw,34rem)] h-auto"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </h1>

    <p
      class="reveal reveal-delay-1 mt-5 font-display text-sm font-semibold uppercase tracking-[0.22em] text-ink/90 md:mt-6 md:text-base"
    >
      {site.heroSubtitle}
    </p>

    <p
      class="reveal reveal-delay-2 mx-auto mt-5 max-w-2xl text-pretty text-base leading-7 text-ink/80 md:mt-6 md:text-lg md:leading-8"
    >
      {site.heroIntro}
    </p>

    <div class="reveal reveal-delay-3 mt-9 flex w-full max-w-sm flex-col gap-3 sm:w-auto sm:max-w-none sm:flex-row md:mt-10">
      <a
        href={site.heroPrimaryCta.href}
        class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-bold text-ink transition-colors hover:bg-accent-soft active:bg-ink active:text-page"
      >
        <span>{site.heroPrimaryCta.label}</span>
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0-4 4m4-4H3"></path>
        </svg>
      </a>
      <a
        href={site.heroSecondaryCta.href}
        class="inline-flex items-center justify-center rounded-full border border-ink/25 bg-page/40 px-6 py-3 text-sm font-bold text-ink transition-colors hover:border-accent hover:text-accent"
      >
        {site.heroSecondaryCta.label}
      </a>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 z-10 border-t border-ink/10 bg-page/40">
    <ul
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-6 gap-y-2 px-5 py-4 text-center md:gap-x-8 md:px-10 md:py-5 lg:gap-x-10 lg:px-16 xl:flex-nowrap xl:gap-x-12"
    >
      {
        heroHighlights.map((item) => (
          <li class="hero-strip-item flex shrink-0 items-center gap-3 whitespace-nowrap text-xs font-semibold uppercase tracking-[0.16em] text-ink/70">
            <span class="font-display text-base font-bold tracking-normal text-ink md:text-lg">{item.label}</span>
            <span class="hidden xl:inline">{item.detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
