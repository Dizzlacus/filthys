---
import { site, services } from '../data/site';
---

<section id="services" class="bg-page reveal">
  <div class="px-5 py-12 md:px-10 md:py-14 lg:px-16 lg:py-24">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto text-left md:text-center">
        <p class="section-kicker">Nights</p>
        <h2
          class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-ink md:text-6xl"
        >
          {site.servicesHeadline}
        </h2>
        <p class="mt-5 text-lg leading-8 text-ink/55">
          {site.servicesSubhead}
        </p>
      </div>

      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          services.map((service) => (
            <div class="glass-card hover-glow rounded-[1.5rem] p-7">
              <div class="mb-7 flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/10 text-accent">
                {service.icon ? (
                  <img
                    src={service.icon}
                    alt=""
                    class="w-6 h-6"
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                  />
                ) : (
                  <svg
                    class="w-6 h-6 text-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <path stroke-linecap="round" d="M3 9h18M9 21V9" />
                  </svg>
                )}
              </div>
              <h3 class="font-display text-2xl font-semibold text-ink">{service.name}</h3>
              <p class="mt-4 text-ink/50 leading-7">{service.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
