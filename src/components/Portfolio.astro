---
import { site, portfolio } from '../data/site';
---

<section id="portfolio" class="bg-page reveal">
  <div class="px-5 py-12 md:px-10 md:py-14 lg:px-16 lg:py-24">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto text-left md:text-center">
        <p class="section-kicker">Residents</p>
        <h2
          class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-ink md:text-6xl"
        >
          {site.portfolioHeadline}
        </h2>
        <p class="mt-5 text-lg leading-8 text-ink/55">
          {site.portfolioSubhead}
        </p>
      </div>

      <div class="mt-8 flex items-center justify-center gap-3 md:hidden">
        <button
          id="portfolio-prev"
          type="button"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-ink/10 bg-surface text-ink/70 transition-colors hover:border-accent/50 hover:text-accent"
          aria-label="Previous night"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19 8 12l7-7"></path>
          </svg>
        </button>
        <button
          id="portfolio-next"
          type="button"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-ink/10 bg-surface text-ink/70 transition-colors hover:border-accent/50 hover:text-accent"
          aria-label="Next night"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"></path>
          </svg>
        </button>
      </div>

      <div
        id="portfolio-track"
        class="no-scrollbar mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-2 md:grid md:overflow-visible md:pb-0 md:grid-cols-2 lg:grid-cols-3"
        aria-label="Residents carousel"
      >
        {
          portfolio.map((item) => (
            <a
              href={item.href}
              class="glass-card hover-glow group min-w-[82vw] snap-start overflow-hidden rounded-[1.5rem] sm:min-w-[420px] md:min-w-0"
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-panel">
                <div
                  class="absolute inset-0 flex items-center justify-center"
                  role="img"
                  aria-label={`${item.title} image placeholder`}
                >
                  <div class="text-center px-6">
                    <div class="mx-auto mb-3 h-10 w-10 rounded-xl bg-accent/10" />
                    <p class="text-sm font-semibold text-ink/45">Photo coming soon</p>
                  </div>
                </div>
                <div
                  class="absolute inset-0 bg-gradient-to-t from-page/40 via-transparent to-transparent"
                  aria-hidden="true"
                />
              </div>

              <div class="p-6">
                <div class="inline-flex rounded-full border border-accent/20 bg-accent/5 px-3 py-1.5 text-xs font-semibold text-accent">
                  {item.status}
                </div>
                <h3 class="mt-5 font-display text-2xl font-bold tracking-[-0.03em] text-ink">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-6 text-ink/50">{item.description}</p>

                <div class="mt-6 flex flex-wrap items-center gap-2">
                  {item.tags.map((tag) => (
                    <span class="rounded-full border border-ink/10 bg-surface px-3 py-1.5 text-xs text-ink/60">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-accent">
                  <span>Find us</span>
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" />
                  </svg>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <div
        id="portfolio-dots"
        class="mt-8 flex justify-center gap-2 md:hidden"
        aria-label="Choose portfolio item"
      >
        {
          portfolio.map((_, index) => (
            <button
              type="button"
              class:list={[
                'h-2.5 rounded-full',
                index === 0 ? 'w-8 bg-accent' : 'w-2.5 bg-ink/20',
              ]}
              aria-label={`Show portfolio item ${index + 1}`}
              data-portfolio-index={index}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
