---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, studentDeals } from '../data/site';
import drummerPhoto from '../assets/images/deals/drummer.jpg';
import dancingPhoto from '../assets/images/deals/dancing.jpg';
import friendsPhoto from '../assets/images/deals/friends.jpg';

interface DealPhoto {
  src: ImageMetadata;
  alt: string;
}

const photos: DealPhoto[] = [
  {
    src: drummerPhoto,
    alt: "A drummer mid-set on the Filthy's stage in front of the venue's poster wall",
  },
  {
    src: dancingPhoto,
    alt: "Someone dancing on the floor at Filthy's under the mezzanine",
  },
  { src: friendsPhoto, alt: "Three friends smiling together at the bar in Filthy's" },
];

const controlClass =
  'absolute top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-ink/20 bg-page/70 text-ink backdrop-blur-sm transition-colors hover:border-accent hover:text-accent';
---

<section id="deals" class="bg-page reveal">
  <div class="px-5 py-12 md:px-10 md:py-14 lg:px-16 lg:py-24">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto text-left md:text-center">
        <p class="section-kicker">Student deals</p>
        <h2
          class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-ink md:text-6xl"
        >
          {site.dealsHeadline}
        </h2>
        <p class="mt-5 text-lg leading-8 text-ink/55">
          {site.dealsSubhead}
        </p>
      </div>

      <div class="mt-12 grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-stretch">
        <div
          class="group glass-card hover-glow relative isolate flex flex-col overflow-hidden rounded-[1.5rem] p-7"
        >
          <div
            class="pointer-events-none absolute inset-0 scale-110 blur-2xl transition-transform duration-500 ease-out group-hover:scale-125 group-focus-within:scale-125 motion-reduce:transition-none motion-reduce:group-hover:scale-110 motion-reduce:group-focus-within:scale-110"
            aria-hidden="true"
          >
            <Picture
              src={dancingPhoto}
              formats={['avif', 'webp']}
              alt=""
              width={dancingPhoto.width}
              height={dancingPhoto.height}
              layout="constrained"
              class="h-full w-full object-cover opacity-40"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div
            class="pointer-events-none absolute inset-0 bg-page/80 transition-colors duration-300 group-hover:bg-page/70 group-focus-within:bg-page/70 motion-reduce:transition-none"
            aria-hidden="true"
          >
          </div>
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-br from-ink/[0.06] via-transparent to-transparent"
            aria-hidden="true"
          >
          </div>

          <div class="relative z-10 flex flex-1 flex-col">
            <p
              class="self-start rounded-full border border-accent/50 bg-accent/10 px-3 py-1 font-display text-xs font-semibold uppercase tracking-[0.18em] text-accent"
            >
              {site.dealsSchedule}
            </p>

            <ul class="mt-5 divide-y divide-ink/10">
              {
                studentDeals.map((deal) => (
                  <li class="flex items-baseline gap-6 py-6 md:py-7">
                    <span class="min-w-[5.5rem] font-display text-6xl font-bold leading-none tracking-[-0.03em] text-accent tabular-nums md:min-w-[7rem] md:text-7xl">
                      {deal.price}
                    </span>
                    <span class="font-display text-lg font-semibold uppercase tracking-[0.18em] text-ink md:text-xl">
                      {deal.label}
                    </span>
                  </li>
                ))
              }
            </ul>

            <a
              href="#whats-on"
              class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-accent transition-colors hover:text-accent-soft"
            >
              See what's on this week <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <div
          class="relative overflow-hidden rounded-[1.5rem] border border-ink/10 lg:h-full lg:min-h-[28rem]"
        >
          <div
            id="deals-track"
            class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto overflow-y-hidden lg:h-full"
            tabindex="0"
            aria-roledescription="carousel"
            aria-label="Filthy's student night photos"
          >
            {
              photos.map((photo, index) => (
                <div
                  class="relative aspect-[4/5] w-full min-w-full shrink-0 snap-center sm:aspect-[3/4] lg:aspect-auto lg:h-full"
                  id={`deals-slide-${index}`}
                  aria-label={`${index + 1} of ${photos.length}`}
                >
                  <div class="absolute inset-0 [&>picture]:h-full [&>picture]:w-full">
                    <Picture
                      src={photo.src}
                      formats={['avif', 'webp']}
                      alt={photo.alt}
                      width={photo.src.width}
                      height={photo.src.height}
                      layout="constrained"
                      class="h-full w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div
                    class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-page/70 to-transparent"
                    aria-hidden="true"
                  />
                </div>
              ))
            }
          </div>

          <button
            type="button"
            id="deals-prev"
            class:list={[controlClass, 'left-3']}
            aria-label="Previous photo"
            aria-controls="deals-track"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            id="deals-next"
            class:list={[controlClass, 'right-3']}
            aria-label="Next photo"
            aria-controls="deals-track"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <div
            id="deals-dots"
            class="absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 gap-2"
            aria-label="Choose photo"
          >
            {
              photos.map((_, index) => (
                <button
                  type="button"
                  class:list={[
                    'h-2.5 rounded-full transition-all',
                    index === 0 ? 'w-8 bg-accent' : 'w-2.5 bg-ink/40',
                  ]}
                  data-deals-index={index}
                  aria-label={`Show photo ${index + 1}`}
                  aria-current={index === 0 ? 'true' : undefined}
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
