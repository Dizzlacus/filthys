---
import { site, withBase } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-page border-t border-ink/10">
  <div class="px-5 md:px-10 lg:px-16 py-10">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-6 text-ink/45 text-sm">
      <img
        src={withBase('/img/filthys-logo.svg')}
        alt=""
        width="160"
        height="68"
        class="h-7 w-auto opacity-80"
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
      <span>&copy; {year} {site.name}</span>
    </div>
  </div>
</footer>
