---
import { site } from '../data/site';

// Replace YOUR_FORMSPREE_ID with your Formspree form ID before going live.
const formspreeEndpoint = 'https://formspree.io/f/YOUR_FORMSPREE_ID';

const fieldClass =
  'w-full rounded-none border-0 border-b border-ink/20 bg-transparent px-0 py-3 text-ink placeholder:text-ink/30 transition-colors focus:border-accent focus:outline-none focus:ring-0';

const details = [
  {
    kicker: 'Call us',
    label: 'Phone',
    value: site.telephone,
    href: `tel:${site.telephone.replace(/\s+/g, '')}`,
  },
  {
    kicker: 'Find us',
    label: 'Location',
    value: `${site.streetAddress}, ${site.addressLocality}`,
    href: undefined,
  },
  {
    kicker: 'Send us email',
    label: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
  },
];
---

<section id="contact" class="bg-page reveal">
  <div class="px-5 py-12 md:px-10 md:py-14 lg:px-16 lg:py-24">
    <div class="max-w-7xl mx-auto">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-20">
        <div class="order-2 lg:order-none">
          <p
            id="contact-form-success"
            class="mb-8 hidden rounded-2xl border border-accent/40 bg-accent/10 px-4 py-3 text-sm text-accent"
            role="status"
            aria-live="polite"
          >
            Thanks — we will get back to you about your booking.
          </p>

          <form id="contact-form" action={formspreeEndpoint} method="POST" class="flex flex-col">
            <input type="hidden" name="_subject" value={`${site.name} contact form`} />
            <label class="hidden" aria-hidden="true">
              <span>Do not fill this out</span>
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" />
            </label>

            <div>
              <label for="contact-name" class="block text-sm text-ink/60">Your name</label>
              <input
                id="contact-name"
                type="text"
                name="name"
                required
                class={fieldClass}
              />
            </div>

            <div class="mt-8">
              <label for="contact-email" class="block text-sm text-ink/60">Your email</label>
              <input
                id="contact-email"
                type="email"
                name="email"
                required
                class={fieldClass}
              />
            </div>

            <div class="mt-8">
              <label for="contact-message" class="block text-sm text-ink/60">Date, time, and party size</label>
              <textarea
                id="contact-message"
                name="message"
                rows="3"
                required
                class:list={[fieldClass, 'min-h-[5.5rem] resize-none']}
              />
            </div>

            <button
              type="submit"
              class="mt-10 inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-ink transition-colors hover:bg-accent-soft active:bg-ink active:text-page"
            >
              <span>Send message</span>
              <svg
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0-4 4m4-4H3"
                ></path>
              </svg>
            </button>
          </form>
        </div>

        <div class="order-1 lg:order-none lg:border-l lg:border-ink/10 lg:pl-16 xl:pl-20">
          <p class="section-kicker">Contact</p>
          <h2
            class="mt-5 font-display text-5xl font-bold tracking-[-0.04em] text-ink md:text-7xl"
          >
            <span class="sr-only">{site.contactHeadline}</span>
            <span aria-hidden="true">
              Book a
              <span class="mt-2 flex items-center gap-4 md:gap-5">
                <svg
                  class="h-[0.85em] w-[0.85em] shrink-0 text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 8v11a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2V8"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16 11h1.5a2.5 2.5 0 0 1 0 5H16"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8.5 12v6M12.5 12v6"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6.5 8c.4-2.2 2.1-3.5 5-3.5s4.6 1.3 5 3.5"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 5.2c.2-.8.8-1.4 1.6-1.4.9 0 1.5.7 1.7 1.4"></path>
                </svg>
                table.
              </span>
            </span>
          </h2>
          <p class="mt-8 max-w-md text-lg leading-8 text-ink/55">
            {site.contactSubhead}
          </p>
          <p class="mt-4 text-sm text-ink/45">{site.contactFormLead}</p>
        </div>
      </div>

      <ul
        class="mt-16 grid gap-8 border-t border-ink/10 pt-10 md:grid-cols-3 md:gap-10"
      >
        {
          details.map((item) => (
            <li>
              <p class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-ink/45">
                {item.kicker}
              </p>
              {item.href ? (
                <a
                  href={item.href}
                  class="mt-3 block font-display text-lg font-semibold text-ink transition-colors hover:text-accent md:text-xl"
                >
                  <span class="sr-only">{item.label}: </span>
                  {item.value}
                </a>
              ) : (
                <p class="mt-3 font-display text-lg font-semibold text-ink md:text-xl">
                  <span class="sr-only">{item.label}: </span>
                  {item.value}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
