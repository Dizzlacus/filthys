---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`Privacy Policy — ${site.name}`}
  description={`Placeholder privacy policy for ${site.name}. Replace with your legal text before publishing.`}
  stickyNav={false}
>
  <main class="max-w-screen-md mx-auto px-5 md:px-8 py-16 lg:py-24">
    <div class="mb-12">
      <h1 class="font-display text-4xl font-bold text-ink leading-[1.2] tracking-tight mb-4">
        Privacy Policy
      </h1>
      <p class="text-ink/45 text-sm">Last updated: September 2026</p>
    </div>

    <div class="flex flex-col gap-10 text-base text-ink/70 leading-relaxed">
      <p>
        This is a placeholder privacy policy for <strong class="text-ink">{site.name}</strong>.
        Replace this page with your own legal copy before publishing.
      </p>

      <section>
        <h2 class="font-display text-xl font-semibold text-ink mb-3 tracking-tight">
          1. Who we are
        </h2>
        <p>
          {site.legalName} operates this website. Contact:
          <a href={`mailto:${site.email}`} class="text-accent underline underline-offset-2"
            >{site.email}</a
          >.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl font-semibold text-ink mb-3 tracking-tight">
          2. What we collect
        </h2>
        <p>
          Typically: name, email, and message content from the contact form, plus basic analytics if
          you enable Google Analytics.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl font-semibold text-ink mb-3 tracking-tight">
          3. How we use it
        </h2>
        <p>
          To respond to enquiries and improve the site. Do not publish until this matches your real
          practices and jurisdiction.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
