---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, plans, openingHours, withBase } from '../data/site';
---

<BaseLayout
  title={`Deals & hours — ${site.name}`}
  description="Student and industry drinks deals, plus opening hours at Filthy's on the Bigg Market."
  robots="noindex, nofollow"
  stickyNav={false}
  homeLinks={false}
>
  <main class="px-5 py-16 md:px-10 lg:px-16 lg:py-24">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto text-left md:text-center">
        <p class="section-kicker">Deals</p>
        <h1
          class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-ink md:text-6xl"
        >
          Drinks deals through the week.
        </h1>
        <p class="mt-5 text-lg leading-8 text-ink/55">
          Student prices Sunday to Thursday, industry offers midweek and on Sundays.
        </p>
      </div>

      <div
        class:list={[
          'mt-12 grid gap-5',
          plans.length === 1
            ? 'max-w-lg mx-auto'
            : 'md:grid-cols-2 lg:grid-cols-3',
        ]}
      >
        {
          plans.map((plan) => (
            <article
              class:list={[
                'glass-card hover-glow relative flex flex-col rounded-[1.5rem] p-8',
                plan.popular && 'accent-glow',
              ]}
            >
              {plan.popular && (
                <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-accent">
                  Most Popular
                </p>
              )}
              <h2 class="font-display text-2xl font-semibold text-ink">
                {plan.name}
              </h2>
              <p class="mt-3 font-display text-4xl font-bold tracking-tight text-accent">
                {plan.price}
              </p>
              <p class="mt-4 text-ink/55 leading-7">{plan.summary}</p>

              <div class="mt-8">
                <p class="text-sm font-semibold uppercase tracking-wider text-ink/40">
                  {plan.includesLabel}
                </p>
                <ul class="mt-4 flex flex-col gap-3">
                  {plan.includes.map((item) => (
                    <li class="flex gap-3 items-start">
                      <span class="mt-[6px] shrink-0 w-[6px] h-[6px] rounded-full bg-accent" />
                      <span class="text-base text-ink/70 leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {plan.delivery && (
                <p class="mt-8 text-sm text-ink/45">{plan.delivery}</p>
              )}

              <div class="mt-auto pt-6">
                <a
                  href={withBase('#contact')}
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-5 py-3.5 text-sm font-bold text-ink transition-colors hover:bg-accent-soft active:bg-ink active:text-page"
                >
                  Book a table
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <section class="mt-20 pt-16 border-t border-ink/10">
        <div class="max-w-3xl mx-auto text-left md:text-center">
          <p class="section-kicker">Hours</p>
          <h2
            class="mt-5 font-display text-3xl font-bold tracking-[-0.04em] text-ink md:text-5xl"
          >
            Open late on the Bigg Market.
          </h2>
          <p class="mt-5 text-lg leading-8 text-ink/55">
            Live music every night. Doors until 3am.
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-2 max-w-4xl mx-auto">
          {
            openingHours.map((slot) => (
              <article class="glass-card hover-glow flex flex-col rounded-[1.5rem] p-8">
                <h3 class="font-display text-2xl font-semibold text-ink">{slot.days}</h3>
                <p class="mt-3 font-display text-4xl font-bold tracking-tight text-accent">
                  {slot.hours}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <div class="mt-16 pt-8 border-t border-ink/10">
        <a
          href={withBase('/')}
          class="inline-flex items-center gap-2 text-accent hover:text-accent-soft transition-colors text-sm font-medium"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M13 8H3M3 8L7 4M3 8L7 12"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Back to home
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
