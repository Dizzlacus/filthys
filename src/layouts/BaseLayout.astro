---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, nights, openingHours, withBase } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  showMobileNav?: boolean;
  stickyNav?: boolean;
  homeLinks?: boolean;
  robots?: string;
}

const {
  title = site.name,
  description = site.description,
  image = site.ogImage,
  type = 'website',
  showMobileNav = true,
  stickyNav = true,
  homeLinks = true,
  robots = 'index, follow',
} = Astro.props;

const siteURL = Astro.site ?? new URL(site.url);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(withBase(image), siteURL);

const businessId = `${site.url}/#business`;
const websiteId = `${site.url}/#website`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['BarOrPub', 'MusicVenue'],
      '@id': businessId,
      name: site.name,
      legalName: site.legalName,
      url: site.url,
      email: site.email,
      telephone: site.telephone,
      description: site.description,
      image: imageURL.href,
      logo: new URL(withBase('/img/filthys-logo.png'), siteURL).href,
      priceRange: site.priceRange,
      areaServed: site.areaServed,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.streetAddress,
        addressLocality: site.addressLocality,
        addressRegion: site.addressRegion,
        postalCode: site.postalCode,
        addressCountry: site.addressCountry,
      },
      ...(site.sameAs.length ? { sameAs: site.sameAs } : {}),
      knowsAbout: ['Live music', 'Open mic', 'Cocktails', 'DJ nights', 'Bigg Market nightlife'],
      openingHoursSpecification: openingHours.flatMap((slot) =>
        slot.schemaDays.map((dayOfWeek) => ({
          '@type': 'OpeningHoursSpecification',
          dayOfWeek,
          opens: slot.opens,
          closes: slot.closes,
        })),
      ),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: "What's on",
        itemListElement: nights.map((night) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Event',
            name: `${night.title} · ${night.dayLabel}`,
            description: night.description,
          },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: site.name,
      url: site.url,
      description: site.description,
      inLanguage: 'en-GB',
      publisher: { '@id': businessId },
    },
  ],
};

const enableGa = Boolean(site.gaMeasurementId);
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#050505" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={withBase('/favicon-32x32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

    {
      enableGa && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`}
            is:inline
          />
          <script define:vars={{ gaMeasurementId: site.gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaMeasurementId);
          </script>
        </>
      )
    }
  </head>
  <body
    class="min-h-screen bg-page text-ink antialiased selection:bg-accent/15 selection:text-ink"
  >
    <Nav showMobileNav={showMobileNav} sticky={stickyNav} homeLinks={homeLinks} />
    <slot />
    <Footer />
    <script src="../scripts/main.js"></script>
  </body>
</html>
